# Istari — environment template. Copy to .env (`make env`); never commit .env.
# Every variable the backend reads is listed here with a safe local default.

# Database
# Password the compose `db` service is created with and the DSN below uses. Choose it
# before the first `make db-up`: Postgres bakes it into the data volume on first start.
POSTGRES_PASSWORD=CHANGE_ME
# asyncpg DSN. Local dev points at the compose `db` service on loopback:5433.
# `${POSTGRES_PASSWORD}` is expanded by docker compose and by the backend's .env loader.
DATABASE_URL=postgresql+asyncpg://istari:${POSTGRES_PASSWORD}@127.0.0.1:5433/istari
# Optional. Isolated database for `make test` / `make e2e` (migrated + truncated per
# run). Defaults to DATABASE_URL with `_test` appended to the database name.
# TEST_DATABASE_URL=postgresql+asyncpg://istari:${POSTGRES_PASSWORD}@127.0.0.1:5433/istari_test
# Host port the compose `db` service publishes on 127.0.0.1.
POSTGRES_PORT=5433

# Server
# Loopback only for local dev. Containers set 0.0.0.0 behind the proxy.
BIND_HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Set to true when the app is served over HTTPS (adds the Secure cookie flag).
SESSION_COOKIE_SECURE=false
# Server-side session lifetime (idle timeout), in hours.
SESSION_TTL_HOURS=720

# Login throttling: after MAX failures within WINDOW seconds, login is locked
# for LOCKOUT seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300

# Rendering
# IANA timezone used to display dates (review due dates are stored in UTC).
TIMEZONE=America/Chicago

# Content
# Directory holding content packs (`make seed` imports every pack found here).
CONTENT_PACKS_DIR=../content/packs

# Backups
# Where `make backup` writes dumps (the compose app mounts a volume here).
BACKUP_DIR=../backups
